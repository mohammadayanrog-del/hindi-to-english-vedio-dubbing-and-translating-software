# ============================================================
# CELL 4 — Extract Audio + Generate SRT via Whisper
# (Speaker diarization via pyannote-free method using energy-based segmentation)
# ============================================================
import subprocess, json, os, re
import whisper_timestamped as whisper
import torch
from pydub import AudioSegment

assert VIDEO_PATH and os.path.exists(VIDEO_PATH), '❌ Run Cell 3 first and load a video!'

AUDIO_PATH   = '/content/pipeline/input_audio.wav'
SRT_PATH     = '/content/pipeline/subtitles_hindi.srt'
CHUNKS_DIR   = '/content/pipeline/audio_chunks'

# --- Step 4a: Extract full audio from video ---
print('🎵 Extracting audio from video...')
subprocess.run(
    ['ffmpeg', '-y', '-i', VIDEO_PATH, '-vn', '-acodec', 'pcm_s16le',
     '-ar', '44100', '-ac', '2', AUDIO_PATH],
    check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
)
print(f'✅ Audio extracted: {AUDIO_PATH}')

# --- Step 4b: Transcribe with Whisper (Hindi) ---
print('🗣️  Transcribing Hindi audio with Whisper large-v3...')
print('   (This may take several minutes)')
device = 'cuda' if torch.cuda.is_available() else 'cpu'
print(f'   Using device: {device}')

model = whisper.load_model('large-v3', device=device)
result = whisper.transcribe(
    model,
    AUDIO_PATH,
    language='hi',
    detect_disfluencies=False,
    vad=True  # Voice activity detection for cleaner segments
)

# --- Step 4c: Build SRT ---
def ms_to_srt_time(ms):
    ms = int(ms * 1000)  # whisper_timestamped returns seconds
    h, remainder = divmod(ms, 3600000)
    m, remainder = divmod(remainder, 60000)
    s, ms_rem = divmod(remainder, 1000)
    return f'{h:02d}:{m:02d}:{s:02d},{ms_rem:03d}'

segments = result['segments']
srt_lines = []
for i, seg in enumerate(segments, 1):
    srt_lines.append(str(i))
    srt_lines.append(f"{ms_to_srt_time(seg['start'])} --> {ms_to_srt_time(seg['end'])}")
    srt_lines.append(seg['text'].strip())
    srt_lines.append('')

with open(SRT_PATH, 'w', encoding='utf-8') as f:
    f.write('\n'.join(srt_lines))

print(f'✅ Hindi SRT created: {SRT_PATH}')
print(f'   Total segments: {len(segments)}')

# --- Step 4d: Identify speakers (simple heuristic by segment gap/energy) ---
print('\n👥 Performing heuristic speaker detection...')

SPEAKER_GAP_THRESHOLD = 1.5  # seconds
speaker_id = 1
speaker_tags = [1]  # first segment = speaker 1
for i in range(1, len(segments)):
    gap = segments[i]['start'] - segments[i-1]['end']
    if gap > SPEAKER_GAP_THRESHOLD:
        speaker_id += 1
    speaker_tags.append(speaker_id)

# Cap at 4 speakers for practicality
speaker_tags = [min(s, 4) for s in speaker_tags]
NUM_SPEAKERS = max(speaker_tags)

# Save speaker-annotated segment data
segment_data = []
for i, (seg, spk) in enumerate(zip(segments, speaker_tags)):
    segment_data.append({
        'index': i + 1,
        'start': seg['start'],
        'end': seg['end'],
        'duration': seg['end'] - seg['start'],
        'hindi_text': seg['text'].strip(),
        'speaker': spk
    })

with open('/content/pipeline/segment_data.json', 'w', encoding='utf-8') as f:
    json.dump(segment_data, f, ensure_ascii=False, indent=2)

print(f'✅ Speaker detection done. Detected {NUM_SPEAKERS} speaker(s).')
print(f'   Segment data saved to: /content/pipeline/segment_data.json')

# --- Step 4e: Extract per-segment audio chunks ---
print('\n✂️  Extracting audio chunks per SRT segment...')
full_audio = AudioSegment.from_wav(AUDIO_PATH)

for seg in segment_data:
    start_ms = int(seg['start'] * 1000)
    end_ms   = int(seg['end']   * 1000)
    chunk    = full_audio[start_ms:end_ms]
    out_path = os.path.join(CHUNKS_DIR, f"chunk_{seg['index']:04d}.wav")
    chunk.export(out_path, format='wav')

print(f'✅ {len(segment_data)} audio chunks saved to: {CHUNKS_DIR}')
